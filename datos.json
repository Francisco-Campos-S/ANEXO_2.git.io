  "apoyos": {
    "personales": [
      {
        "codigo": "A.P.1",
        "descripcion": "Utilizar su cercanía física para mantenerlo atento a la clase. "
      },
      {
        "codigo": "A.P.2",
        "descripcion": "Utilizar la tutoría entre compañeros. "
      },
      {
        "codigo": "A.P.3",
        "descripcion": "Brindar acercamiento físico y las manifestaciones de apoyo. "
      },
      {
        "codigo": "A.P.4",
        "descripcion": "Reforzar cada logro por más pequeño que este sea. "
      },
      {
        "codigo": "A.P.5",
        "descripcion": "Reforzar la autoestima mediante actividades que le permitan éxito, particularizando en características cognitivas y sociales. "
      },
      {
        "codigo": "A.P.6",
        "descripcion": "Utilizar constantemente la estrategia de trabajo cooperativo con la finalidad de que logre beneficiar y beneficiarse de las experiencias de otros compañeros y así reforzar su seguridad en la ejecución de los aprendizajes. "
      },
      {
        "codigo": "A.P.7",
        "descripcion": "Dar responsabilidades especificas al estudiante dentro del aula y hogar para reforzar su autoconfianza generando responsabilidad e independencia. "
      },
      {
        "codigo": "A.P.8",
        "descripcion": "Utilizar dentro de la propuesta pedagógica actividades que refuercen la autoestima como: expresión de sentimientos, respeto a la diferencia y tolerancia. "
      },
      {
        "codigo": "A.P.9",
        "descripcion": "Utilizar reforzadores sociales como: \"muy bien\", \"usted puede\" y \"siga así\". "
      },
      {
        "codigo": "A.P.10",
        "descripcion": "Utilizar canales sensoriales como: auditivos, kinestésico y táctil para presentar la materia. "
      },
      {
        "codigo": "A.P.11",
        "descripcion": "Generar alguna técnica para recordar frecuentemente la entrega de trabajos a largo plazo."
      },
      {
        "codigo": "A.P.12",
        "descripcion": "Referir a otros especialistas (orientador, docente de apoyo, psicología, terapia física, terapia de lenguaje, otros). "
      },
